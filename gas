    { key: 'bank',    sheet: SHEET.BANK,    dateCol: 1, shopCol: 2, amountCol: 3, catCol: 5 },
    { key: 'cash',    sheet: SHEET.CASH,    dateCol: 1, shopCol: 2, amountCol: 3, catCol: 4 },
  ];

  const rows = [];
  sources.forEach(src => {
    const ws = ss.getSheetByName(src.sheet);
