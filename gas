const SHEET = {
  RAKUTEN:    '楽天カード',
  SMBC:       '三井住友',
  PAYPAY:     'PayPay',
  BANK:       '楽天銀行',
  CASH:       '現金',
  ASSET:      '資産残高',
  CATEGORIES: 'カテゴリ',
  KEYWORDS:   'キーワードルール',
  SETTINGS:   '設定',
  IMPORTS:    '取込履歴',
};

// 資産残高シートの列定義
const ASSET_COLS = {
  DATE:        1,
  CASH:        2,
  YUCHO:       3,
  RAKUTEN:     4,
  BANK_TOTAL:  5,
  PAYPAY:      6,
  SAFE_TOTAL:  7,
  MONTHLY_INV: 8,
  CUM_INV:     9,
  SEC_VALUE:   10,
  PNL:         11,
  RATE:        12,
  RISK_TOTAL:  13,
  TOTAL:       14,
  PREV_DIFF:   15,
};

// ================================================================
// エントリポイント
// ================================================================
function doPost(e) {
  try {
    let params;
    const raw = e.postData.contents || '';
    if (raw.startsWith('payload=')) {
      const decoded = decodeURIComponent(raw.slice('payload='.length).replace(/\+/g, ' '));
      params = JSON.parse(decoded);
    } else {
      params = JSON.parse(raw);
    }

    let result;
    switch (params.action) {
      case 'addAccount':          result = addAccount(params);          break;
      case 'updateCustomBalance': result = updateCustomBalance(params); break;
      case 'updateAllBalances':   result = updateAllBalances(params);   break;
      case 'getLatestAsset':      result = getLatestAsset(params);      break;
      case 'getBalanceCheck':     result = getBalanceCheck(params);     break;
      case 'addCheckAdjust':      result = addCheckAdjust(params);      break;
      case 'importCSV':           result = importCSV(params);           break;
      case 'addCash':             result = addCash(params);             break;
      case 'updateBalance':       result = updateBalance(params);       break;
      case 'updateSecurities':    result = updateSecurities(params);    break;
      case 'updateDeposit':       result = updateDeposit(params);       break;
      case 'completeReconcile':   result = completeReconcile(params);   break;
      case 'addAdjustment':       result = addAdjustment(params);       break;
      case 'getInitialData':      result = getInitialData(params);      break;
      case 'getCategories':       result = getCategories();             break;
      case 'getKeywordRules':     result = getKeywordRules();           break;
      case 'saveKeywordRules':    result = saveKeywordRules(params);    break;
      case 'saveCategories':      result = saveCategories(params);      break;
      case 'getSummary':          result = getSummary(params);          break;
      case 'getAssetTrend':       result = getAssetTrend(params);       break;
      case 'getSecRate':          result = getSecRate(params);          break;
      case 'getSettings':         result = getSettings();               break;
      case 'saveSettings':        result = saveSettings(params);        break;
      case 'getDetails':          result = getDetails(params);          break;
      case 'updateDetail':        result = updateDetail(params);        break;
      case 'deleteDetail':        result = deleteDetail(params);        break;
      case 'updateCategories':    result = updateCategories(params);    break;
      case 'deduplicateSheet':    result = deduplicateSheet(params);    break;
      case 'cancelImport':        result = cancelImport(params);        break;
      default: result = { ok: false, error: '不明なアクション: ' + params.action };
    }
    return json(result);
  } catch (err) {
    return json({ ok: false, error: err.message, raw: (e.postData || {}).contents });
  }
}

function doGet() {
  return json({ ok: true, message: 'おかねノート GAS稼働中' });
}

function json(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.TEXT);
}

// ================================================================
// セットアップ
// ================================================================
function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const defs = [
    { name: SHEET.RAKUTEN,    headers: ['引落日','利用日','店名・商品名','金額（円）','カテゴリ','取込ファイル','明細月'] },
    { name: SHEET.SMBC,       headers: ['引落日','利用日','店名','金額（円）','カテゴリ','取込ファイル','明細月'] },
    { name: SHEET.PAYPAY,     headers: ['利用日','店名','金額（円）','カテゴリ','取込ファイル','明細月'] },
    { name: SHEET.BANK,       headers: ['取引日','摘要','出金額（円）','入金額（円）','カテゴリ','取込ファイル','明細月'] },
    { name: SHEET.CASH,       headers: ['日付','店名・内容','金額（円）','カテゴリ'] },
    { name: SHEET.ASSET,      headers: ['日付','現金','ゆうちょ','楽天銀行','(楽天+ゆうちょ)','PayPay','純資産','月次入金額','累計投資額','評価額','損益','利率(%)','リスク資産','総資産','先月との差'] },
    { name: SHEET.CATEGORIES, headers: ['カテゴリ名'] },
    { name: SHEET.KEYWORDS,   headers: ['キーワード','カテゴリ'] },
    { name: SHEET.SETTINGS,   headers: ['キー','値'] },
    { name: SHEET.IMPORTS,    headers: ['取込日時','カード種別','ファイル名','件数','合計金額','明細月'] },
  ];

  const report = [];
  defs.forEach(({ name, headers }) => {
    let ws = ss.getSheetByName(name);
    if (!ws) { ws = ss.insertSheet(name); report.push(`✅ 新規作成: ${name}`); }
    const currentHeaders = ws.getLastRow() > 0
      ? ws.getRange(1, 1, 1, Math.max(ws.getLastColumn(), headers.length)).getValues()[0]
      : [];
    const needsUpdate = headers.some((h, i) => currentHeaders[i] !== h);
    if (needsUpdate) {
      ws.getRange(1, 1, 1, headers.length).setValues([headers]);
      report.push(`🔧 ヘッダー修正: ${name}`);
    } else {
      report.push(`— 変更なし: ${name}`);
    }
    ws.getRange(1, 1, 1, headers.length)
      .setBackground('#2E4057').setFontColor('#FFFFFF').setFontWeight('bold');
    ws.setFrozenRows(1);
  });

  const catWs = ss.getSheetByName(SHEET.CATEGORIES);
  if (catWs.getLastRow() <= 1) {
    ['食費','交通費','日用品','趣味・娯楽','医療・健康','衣類','水道光熱費','通信費','保険','投資','その他']
      .forEach(c => catWs.appendRow([c]));
    report.push('✅ デフォルトカテゴリを追加');
  }

  const setWs = ss.getSheetByName(SHEET.SETTINGS);
  const existingKeys = setWs.getLastRow() > 1
    ? setWs.getRange(2, 1, setWs.getLastRow()-1, 1).getValues().flat()
    : [];
  [['rakuten_billing_day','27'],['smbc_billing_day','10'],
   ['paypay_use_txdate','true'],['monthly_deposit','50000'],
   ['dup_check_enabled','true']]
    .forEach(([k, v]) => {
      if (!existingKeys.includes(k)) { setWs.appendRow([k, v]); report.push(`✅ 設定追加: ${k}`); }
    });

  SpreadsheetApp.getUi().alert('✅ セットアップ完了！\n\n' + report.join('\n'));
}

// ================================================================
// 資産残高シートから指定年月の総資産を取得
// ================================================================
function getLatestAsset(params) {
  const { yearMonth } = params;
  const ws = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET.ASSET);
  if (!ws || ws.getLastRow() < 2) return { ok: true, hasData: false, total: 0, prevTotal: null };

  const lastCol = ws.getLastColumn();
  const data = ws.getRange(2, 1, ws.getLastRow() - 1, lastCol).getValues();

  function normalizeYM(val) {
    if (val instanceof Date) return val.getFullYear() + '/' + String(val.getMonth() + 1).padStart(2, '0');
    return String(val).substring(0, 7);
  }

  const C = ASSET_COLS;
  const targetRows = data.filter(row => normalizeYM(row[0]) === yearMonth);
  const targetRow = targetRows.length > 0
    ? targetRows.reduce((best, row) => (Number(row[C.TOTAL-1]) || 0) > (Number(best[C.TOTAL-1]) || 0) ? row : best, targetRows[0])
    : null;

  const [y, m] = yearMonth.split('/').map(Number);
  const prevYM = `${m === 1 ? y - 1 : y}/${String(m === 1 ? 12 : m - 1).padStart(2, '0')}`;
  const prevRows = data.filter(row => normalizeYM(row[0]) === prevYM);
  const prevRow = prevRows.length > 0
    ? prevRows.reduce((best, row) => (Number(row[C.TOTAL-1]) || 0) > (Number(best[C.TOTAL-1]) || 0) ? row : best, prevRows[0])
    : null;

  const total         = targetRow ? (Number(targetRow[C.TOTAL-1])        || 0) : 0;
  const prevTotal     = prevRow   ? (Number(prevRow[C.TOTAL-1])          || 0) : null;
  const prevSafe      = prevRow   ? (Number(prevRow[C.SAFE_TOTAL-1])     || 0) : null;
  const prevRisk      = prevRow   ? (Number(prevRow[C.RISK_TOTAL-1])     || 0) : null;
  const cash          = targetRow ? (Number(targetRow[C.CASH-1])         || 0) : 0;
  const yucho         = targetRow ? (Number(targetRow[C.YUCHO-1])        || 0) : 0;
  const rakuten       = targetRow ? (Number(targetRow[C.RAKUTEN-1])      || 0) : 0;
  const paypay        = targetRow ? (Number(targetRow[C.PAYPAY-1])       || 0) : 0;
  const prevDiff      = targetRow ? (Number(targetRow[C.PREV_DIFF-1])    || 0) : 0;
  const monthlyInvest = targetRow ? (Number(targetRow[C.MONTHLY_INV-1])  || 0) : 0;
  const cumInvest     = targetRow ? (Number(targetRow[C.CUM_INV-1])      || 0) : 0;
  const pnl           = targetRow ? (Number(targetRow[C.PNL-1])          || 0) : 0;
  const riskTotal     = cumInvest + pnl;

  return { ok: true, hasData: targetRow !== null, yearMonth, total, prevTotal, prevSafe, prevRisk, prevDiff,
           cash, yucho, rakuten, paypay, pnl, monthlyInvest,
           safeTotal: (cash + yucho + rakuten + paypay),
           riskTotal, cumInvest };
}

// ================================================================
// 全口座残高を月次履歴として記録
// ================================================================
function updateAllBalances(params) {
  const { yearMonth, cash, yucho, rakuten, paypay, monthlyInvest, secValue } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const C  = ASSET_COLS;

  function normalizeYM(val) {
    if (val instanceof Date) return val.getFullYear() + '/' + String(val.getMonth() + 1).padStart(2, '0');
    return String(val).substring(0, 7);
  }

  const assetWs = ss.getSheetByName(SHEET.ASSET);

  if (assetWs.getLastRow() > 1) {
    const yms = assetWs.getRange(2, 1, assetWs.getLastRow() - 1, 1).getValues().flat();
    for (let i = yms.length - 1; i >= 0; i--) {
      if (normalizeYM(yms[i]) === yearMonth) assetWs.deleteRow(i + 2);
    }
  }

  let cumInvest = monthlyInvest || 0;
  if (assetWs.getLastRow() > 1) {
    const assetRows = assetWs.getRange(2, 1, assetWs.getLastRow() - 1, C.MONTHLY_INV).getValues();
    assetRows.forEach(r => {
      const ym = normalizeYM(r[0]);
      if (ym < yearMonth) cumInvest += Number(r[C.MONTHLY_INV - 1]) || 0;
    });
  }

  const _cash      = cash          || 0;
  const _yucho     = yucho         || 0;
  const _rak       = rakuten       || 0;
  const _pp        = paypay        || 0;
  const _mInv      = monthlyInvest || 0;
  const _pnl       = secValue      || 0;
  const _cumInv    = cumInvest;
  const _rate      = _cumInv > 0 ? Math.round(_pnl / _cumInv * 10000) / 100 : 0;
  const _bankTotal = _rak + _yucho;
  const _safeTotal = _cash + _yucho + _rak + _pp;
  const _riskTotal = _cumInv + _pnl;
  const _total     = _safeTotal + _riskTotal;

  const [y, m] = yearMonth.split('/').map(Number);
  const prevYM = `${m === 1 ? y-1 : y}/${String(m === 1 ? 12 : m-1).padStart(2,'0')}`;
  let prevTotal = 0;
  if (assetWs.getLastRow() > 1) {
    const rows = assetWs.getRange(2, 1, assetWs.getLastRow()-1, C.TOTAL).getValues();
    rows.forEach(r => { if (normalizeYM(r[0]) === prevYM) prevTotal = Number(r[C.TOTAL-1]) || 0; });
  }
  const _prevDiff = _total - prevTotal;

  const today   = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd');
  const _secVal = _cumInv + _pnl;

  const assetVals = new Array(15).fill('');
  assetVals[C.DATE-1]        = today;
  assetVals[C.CASH-1]        = _cash;
  assetVals[C.YUCHO-1]       = _yucho;
  assetVals[C.RAKUTEN-1]     = _rak;
  assetVals[C.BANK_TOTAL-1]  = _bankTotal;
  assetVals[C.PAYPAY-1]      = _pp;
  assetVals[C.SAFE_TOTAL-1]  = _safeTotal;
  assetVals[C.MONTHLY_INV-1] = _mInv;
  assetVals[C.CUM_INV-1]     = _cumInv;
  assetVals[C.SEC_VALUE-1]   = _secVal;
  assetVals[C.PNL-1]         = _pnl;
  assetVals[C.RATE-1]        = _rate;
  assetVals[C.RISK_TOTAL-1]  = _riskTotal;
  assetVals[C.TOTAL-1]       = _total;
  assetVals[C.PREV_DIFF-1]   = _prevDiff;
  assetWs.appendRow(assetVals);

  return { ok: true, total: _total, safeTotal: _safeTotal, riskTotal: _riskTotal, pnl: _pnl, rate: _rate, prevDiff: _prevDiff };
}

// ================================================================
// 収支照合
// ================================================================
function getBalanceCheck(params) {
  const { yearMonth } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  function normalizeYM(val) {
    if (val instanceof Date) return val.getFullYear() + '/' + String(val.getMonth() + 1).padStart(2, '0');
    return String(val).substring(0, 7);
  }

  const [y, m] = yearMonth.split('/').map(Number);
  const prevYM = `${m === 1 ? y-1 : y}/${String(m === 1 ? 12 : m-1).padStart(2,'0')}`;

  const assetWs = ss.getSheetByName(SHEET.ASSET);
  const C = ASSET_COLS;
  let safeCur = null, safePrev = null;
  if (assetWs && assetWs.getLastRow() > 1) {
    const rows = assetWs.getRange(2, 1, assetWs.getLastRow()-1, C.SAFE_TOTAL).getValues();
    rows.forEach(r => {
      const ym = normalizeYM(r[0]);
      if (ym === yearMonth) safeCur  = Number(r[C.SAFE_TOTAL-1]) || 0;
      if (ym === prevYM)    safePrev = Number(r[C.SAFE_TOTAL-1]) || 0;
    });
  }

  const safeChange = (safeCur != null && safePrev != null) ? safeCur - safePrev : null;

  const expSources = [
    { sheet: SHEET.RAKUTEN, dateCol: 1, amountCol: 4 },
    { sheet: SHEET.SMBC,    dateCol: 1, amountCol: 4 },
    { sheet: SHEET.PAYPAY,  dateCol: 1, amountCol: 3 },
    { sheet: SHEET.BANK,    dateCol: 1, amountCol: 3 },
  ];
  let totalExp = 0;
  expSources.forEach(src => {
    const ws = ss.getSheetByName(src.sheet);
    if (!ws || ws.getLastRow() < 2) return;
    const data = ws.getRange(2, 1, ws.getLastRow()-1, Math.max(src.dateCol, src.amountCol)).getValues();
    data.forEach(r => {
      if (normalizeYM(r[src.dateCol-1]) !== yearMonth) return;
      totalExp += Number(r[src.amountCol-1]) || 0;
    });
  });

  let cashIncome = 0, cashExp = 0;
  const cashWs = ss.getSheetByName(SHEET.CASH);
  if (cashWs && cashWs.getLastRow() > 1) {
    const data = cashWs.getRange(2, 1, cashWs.getLastRow()-1, 3).getValues();
    data.forEach(r => {
      if (normalizeYM(r[0]) !== yearMonth) return;
      const amt = Number(r[2]) || 0;
      if (amt < 0) cashIncome += Math.abs(amt);
      else         cashExp    += amt;
    });
  }

  const totalIncome = cashIncome;
  const totalExpAll = totalExp + cashExp;
  const kakeiboChange = totalIncome - totalExpAll;
  const diff = safeChange != null ? safeChange - kakeiboChange : null;

  return { ok: true, yearMonth, prevYM, safeCur, safePrev, safeChange,
           totalIncome, totalExp: totalExpAll, cashIncome, cashExp, kakeiboChange, diff };
}

function addCheckAdjust(params) {
  const { yearMonth, amount, memo } = params;
  const today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd');
  const note  = `【照合調整】${memo || yearMonth}`;
  SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(SHEET.CASH)
    .appendRow([today, note, amount, '照合調整']);
  return { ok: true };
}

// ================================================================
// 口座追加・カスタム口座残高更新
// ================================================================
function addAccount(params) {
  const { account, yearMonth, balance } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let masterWs = ss.getSheetByName('口座マスタ');
  if (!masterWs) {
    masterWs = ss.insertSheet('口座マスタ');
    masterWs.appendRow(['ID', '口座名', '種別', '登録日時']);
    masterWs.getRange(1, 1, 1, 4).setBackground('#2E4057').setFontColor('#FFFFFF').setFontWeight('bold');
    masterWs.setFrozenRows(1);
  }
  masterWs.appendRow([
    String(account.id), account.name, account.type,
    Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm')
  ]);

  if (balance > 0 && yearMonth) {
    const assetWs = ss.getSheetByName(SHEET.ASSET);
    const headerRow = assetWs.getRange(1, 1, 1, assetWs.getLastColumn()).getValues()[0];
    let colIdx = headerRow.indexOf(account.name);
    if (colIdx < 0) {
      colIdx = assetWs.getLastColumn();
      assetWs.getRange(1, colIdx + 1).setValue(account.name);
    }
    const row = findOrCreateAssetRow(assetWs, yearMonth);
    assetWs.getRange(row, colIdx + 1).setValue(balance);
  }

  return { ok: true };
}

function updateCustomBalance(params) {
  const { yearMonth, name, balance } = params;
  if (!yearMonth || !name) return { ok: false, error: 'パラメータ不足' };
  const ss  = SpreadsheetApp.getActiveSpreadsheet();
  const ws  = ss.getSheetByName(SHEET.ASSET);
  const headerRow = ws.getRange(1, 1, 1, ws.getLastColumn()).getValues()[0];
  let colIdx = headerRow.indexOf(name);
  if (colIdx < 0) {
    colIdx = ws.getLastColumn();
    ws.getRange(1, colIdx + 1).setValue(name);
  }
  const row = findOrCreateAssetRow(ws, yearMonth);
  ws.getRange(row, colIdx + 1).setValue(balance);
  return { ok: true };
}

// ================================================================
// CSV / PDF 取込
// ================================================================
function importCSV(params) {
  const { cardType, filename, rows, statementYearMonth, allowPartial } = params;

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // ── 重複チェック（ファイル名単位）──
  let alreadyImported = false;
  if (getSettingValue('dup_check_enabled') === 'true') {
    const impWs = ss.getSheetByName(SHEET.IMPORTS);
    if (impWs.getLastRow() > 1) {
      const history = impWs.getRange(2, 3, impWs.getLastRow() - 1, 1).getValues().flat();
      alreadyImported = history.includes(filename);
    }
  }

  // allowPartial=false のときのみファイル名重複で拒否
  if (alreadyImported && !allowPartial) {
    return { ok: false, duplicate: true, message: '取込済みファイル: ' + filename };
  }

  const settings = loadSettings();
  const stmYM = statementYearMonth || '';

  const sheetMap = { rakuten: SHEET.RAKUTEN, smbc: SHEET.SMBC, paypay: SHEET.PAYPAY, bank: SHEET.BANK };
  const sheetName = sheetMap[cardType];
  if (!sheetName) return { ok: false, error: '不明なカード種別: ' + cardType };

  const ws = ss.getSheetByName(sheetName);

  // ── 明細単位の重複チェック（常に既存行と照合）──
  // ファイル名の一致に関係なく、シートに既にある行はスキップする
  const existingKeys = new Set();

  // Date型・文字列どちらでも "yyyy/MM/dd" に正規化
  function toDateStr(val) {
    if (!val) return '';
    if (val instanceof Date) return Utilities.formatDate(val, 'Asia/Tokyo', 'yyyy/MM/dd');
    return String(val).substring(0, 10);
  }

  if (ws.getLastRow() > 1) {
    const maxCol = (cardType === 'paypay' || cardType === 'bank') ? 3 : 4;
    const existingData = ws.getRange(2, 1, ws.getLastRow() - 1, maxCol).getValues();
    existingData.forEach(r => {
      // rakuten/smbc: A=引落日, B=利用日, C=店名, D=金額 → 利用日(B)+店名(C)+金額(D)でキー
      // paypay/bank:  A=利用日, B=店名,  C=金額          → 利用日(A)+店名(B)+金額(C)でキー
      const key = (cardType === 'paypay' || cardType === 'bank')
        ? `${toDateStr(r[0])}|${r[1]}|${r[2]}`
        : `${toDateStr(r[1])}|${r[2]}|${r[3]}`;
      existingKeys.add(key);
    });
  }

  // ── 書き込み行を生成 ──
  const writeRows = [];
  let skipped = 0;

  if (cardType === 'rakuten') {
    const day = parseInt(settings['rakuten_billing_day'] || '27');
    // 引落日 = ユーザー指定月のday日（利用日が何月でも統一）
    const billingDate = stmYMtoBillingDate(stmYM, day);
    rows.forEach(r => {
      const key = `${String(r.date).substring(0,10)}|${r.shop}|${r.amount}`;
      if (existingKeys.has(key)) { skipped++; return; }
      writeRows.push([billingDate, r.date, r.shop, r.amount, '', filename, stmYM]);
    });

  } else if (cardType === 'smbc') {
    const day = parseInt(settings['smbc_billing_day'] || '10');
    // 引落日 = ユーザー指定月のday日（利用日が何月でも統一）
    const billingDate = stmYMtoBillingDate(stmYM, day);
    rows.forEach(r => {
      const key = `${String(r.date).substring(0,10)}|${r.shop}|${r.amount}`;
      if (existingKeys.has(key)) { skipped++; return; }
      writeRows.push([billingDate, r.date, r.shop, r.amount, '', filename, stmYM]);
    });

  } else if (cardType === 'paypay') {
    rows.forEach(r => {
      const key = `${String(r.date).substring(0,10)}|${r.shop}|${r.amount}`;
      if (existingKeys.has(key)) { skipped++; return; }
      writeRows.push([r.date, r.shop, r.amount, '', filename, stmYM]);
    });

  } else if (cardType === 'bank') {
    rows.filter(r => (r.withdrawal || 0) > 0).forEach(r => {
      const key = `${String(r.date).substring(0,10)}|${r.shop}|${r.withdrawal}`;
      if (existingKeys.has(key)) { skipped++; return; }
      writeRows.push([r.date, r.shop, r.withdrawal, r.deposit || 0, '', filename, stmYM]);
    });
  }

  // G列ヘッダー確認
  if (ws.getLastRow() === 1 || ws.getRange(1, 7).getValue() === '') {
    ws.getRange(1, 7).setValue('明細月');
  }

  writeRows.forEach(row => ws.appendRow(row));

  // 取込履歴（初回のみ記録）
  if (!alreadyImported) {
    const total = rows.reduce((s, r) => s + (r.amount || r.withdrawal || 0), 0);
    ss.getSheetByName(SHEET.IMPORTS).appendRow([
      Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'),
      cardType, filename, writeRows.length, total, stmYM
    ]);
  }

  if (writeRows.length === 0) {
    return { ok: true, count: 0, skipped, message: 'すべて取込済みのためスキップしました' };
  }

  return { ok: true, count: writeRows.length, skipped };
}

// 明細月（例:"2026/04"）と引落日から引落日文字列を生成
// 利用日の月に関わらず、ユーザー指定月のday日で統一する
function stmYMtoBillingDate(stmYM, billingDay) {
  if (!stmYM) return '';
  const [y, m] = stmYM.split('/').map(Number);
  const billing = new Date(y, m - 1, billingDay);
  return Utilities.formatDate(billing, 'Asia/Tokyo', 'yyyy/MM/dd');
}

// （後方互換用・現在は使用しない）
function calcBillingDate(txDateStr, billingDay) {
  const d = new Date(String(txDateStr).replace(/\//g, '-'));
  const billing = new Date(d.getFullYear(), d.getMonth() + 1, billingDay);
  return Utilities.formatDate(billing, 'Asia/Tokyo', 'yyyy/MM/dd');
}

