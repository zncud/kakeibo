// ================================================================
function loadSettings() {
  const ws = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET.SETTINGS);
  if (!ws || ws.getLastRow() < 2) return {};
  return Object.fromEntries(
    ws.getRange(2, 1, ws.getLastRow() - 1, 2).getValues()
      .filter(([k]) => k).map(([k, v]) => [k, String(v)])
  );
}
function getSettingValue(key) { return loadSettings()[key] || ''; }
function saveSettingValue(key, value) {
  const ws = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET.SETTINGS);
  if (ws.getLastRow() > 1) {
    const keys = ws.getRange(2, 1, ws.getLastRow() - 1, 1).getValues().flat();
    const idx = keys.indexOf(key);
    if (idx >= 0) { ws.getRange(idx + 2, 2).setValue(value); return; }
  }
  ws.appendRow([key, value]);
}

function findOrCreateAssetRow(ws, yearMonth) {
  if (ws.getLastRow() > 1) {
    const yms = ws.getRange(2, 1, ws.getLastRow() - 1, 1).getValues().flat().map(String);
    const idx = yms.indexOf(yearMonth);
    if (idx >= 0) return idx + 2;
  }
  ws.appendRow([yearMonth, 0, 0, 0, 0, '未照合', '']);
  return ws.getLastRow();
}

