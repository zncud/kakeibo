// ================================================================
// サマリー取得
// ================================================================
function toYM(val) {
  if (!val && val !== 0) return '';
  if (val instanceof Date) return val.getFullYear() + '/' + String(val.getMonth() + 1).padStart(2, '0');
  return String(val).substring(0, 7);
}

function getSummary(params) {
  const { year, month } = params;
  const ym = `${year}/${String(month).padStart(2, '0')}`;
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sources = [
    { key: 'rakuten', sheet: SHEET.RAKUTEN, dateCol: 1, amountCol: 4, catCol: 5, label: '楽天カード' },
    { key: 'smbc',    sheet: SHEET.SMBC,    dateCol: 1, amountCol: 4, catCol: 5, label: '三井住友カード' },
    { key: 'paypay',  sheet: SHEET.PAYPAY,  dateCol: 1, amountCol: 3, catCol: 4, label: 'PayPay' },
    { key: 'cash',    sheet: SHEET.CASH,    dateCol: 1, amountCol: 3, catCol: 4, label: '現金' },
  ];

  const breakdown = {}, categoryTotals = {};
  let grandTotal = 0, totalIncome = 0;

  sources.forEach(src => {
    const ws = ss.getSheetByName(src.sheet);
    let total = 0;
    if (ws && ws.getLastRow() > 1) {
      const maxCol = Math.max(src.dateCol, src.amountCol, src.catCol);
      const data = ws.getRange(2, 1, ws.getLastRow() - 1, maxCol).getValues();
      data.forEach(row => {
        if (toYM(row[src.dateCol - 1]) !== ym) return;
        const amt = Number(row[src.amountCol - 1]) || 0;
        if (amt === 0) return;
        if (amt < 0) { totalIncome += Math.abs(amt); return; }
        total += amt;
        grandTotal += amt;
        const cat = String(row[src.catCol - 1] || 'その他').trim() || 'その他';
        categoryTotals[cat] = (categoryTotals[cat] || 0) + amt;
      });
    }
    breakdown[src.key] = { label: src.label, total };
  });

  return { ok: true, yearMonth: ym, grandTotal, totalIncome, balance: totalIncome - grandTotal, breakdown, categoryTotals };
}

