  const lastCol = Math.max(C.TOTAL, C.SAFE_TOTAL, C.RISK_TOTAL, C.CASH, C.YUCHO, C.RAKUTEN, C.PAYPAY);
  const data = ws.getRange(2, 1, ws.getLastRow() - 1, lastCol).getValues();

  function normalizeYM(val) {
    if (val instanceof Date) return val.getFullYear() + '/' + String(val.getMonth() + 1).padStart(2, '0');
    return String(val).substring(0, 7);
  }

  const byMonth = {};
  data.forEach(r => {
    const ym = normalizeYM(r[0]);
    if (!ym.startsWith(String(year))) return;
    const total = Number(r[C.TOTAL-1]) || 0;
    if (!byMonth[ym] || total > byMonth[ym].total) {
