    const data = ws.getRange(2, 1, ws.getLastRow() - 1, maxCol).getValues();
    data.forEach((row, i) => {
      if (toYM(row[src.dateCol - 1]) !== ym) return;
      const amt = Number(row[src.amountCol - 1]) || 0;
      if (amt === 0) return;
      rows.push({
        src: src.key, rowNum: i + 2,
        date: Utilities.formatDate(row[src.dateCol-1] instanceof Date ? row[src.dateCol-1] : new Date(row[src.dateCol-1]), 'Asia/Tokyo', 'yyyy/MM/dd'),
        shop: String(row[src.shopCol - 1] || ''),
        amount: amt, type: amt < 0 ? 'income' : 'expense',
        category: String(row[src.catCol - 1] || ''),
      });
    });
  });

  rows.sort((a, b) => b.date.localeCompare(a.date));
  return { ok: true, rows };
}

function updateDetail(params) {
  const { src, rowNum, shop, amount, category, date } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetMap = {
    rakuten: { sheet: SHEET.RAKUTEN, dateCol: 1, shopCol: 3, amountCol: 4, catCol: 5 },
    smbc:    { sheet: SHEET.SMBC,    dateCol: 1, shopCol: 3, amountCol: 4, catCol: 5 },
    paypay:  { sheet: SHEET.PAYPAY,  dateCol: 1, shopCol: 2, amountCol: 3, catCol: 4 },
    bank:    { sheet: SHEET.BANK,    dateCol: 1, shopCol: 2, amountCol: 3, catCol: 5 },
    cash:    { sheet: SHEET.CASH,    dateCol: 1, shopCol: 2, amountCol: 3, catCol: 4 },
  };
  const m = sheetMap[src];
  if (!m) return { ok: false, error: '不明なソース: ' + src };
  const ws = ss.getSheetByName(m.sheet);
  ws.getRange(rowNum, m.shopCol).setValue(shop);
  ws.getRange(rowNum, m.amountCol).setValue(amount);
  ws.getRange(rowNum, m.catCol).setValue(category);
  if (date) ws.getRange(rowNum, m.dateCol).setValue(date);
  return { ok: true };
}

function deleteDetail(params) {
  const { src, rowNum } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetMap = {
    rakuten: SHEET.RAKUTEN, smbc: SHEET.SMBC, paypay: SHEET.PAYPAY,
    bank: SHEET.BANK, cash: SHEET.CASH,
  };
  const sheetName = sheetMap[src];
  if (!sheetName) return { ok: false, error: '不明なソース: ' + src };
  ss.getSheetByName(sheetName).deleteRow(rowNum);
  return { ok: true };
}

function updateCategories(params) {
  const { updates } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const catColMap = { rakuten: 5, smbc: 5, paypay: 4, bank: 5, cash: 4 };
  const sheetMap  = { rakuten: SHEET.RAKUTEN, smbc: SHEET.SMBC, paypay: SHEET.PAYPAY, bank: SHEET.BANK, cash: SHEET.CASH };
  updates.forEach(u => {
    const ws = ss.getSheetByName(sheetMap[u.src]);
    if (!ws || !u.rowNum) return;
    ws.getRange(u.rowNum, catColMap[u.src]).setValue(u.category);
  });
  return { ok: true, count: updates.length };
}

// ================================================================
// 重複行削除
// ================================================================
function deduplicateSheet(params) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const targets = params?.sheets
    ? params.sheets
    : [SHEET.RAKUTEN, SHEET.SMBC, SHEET.PAYPAY, SHEET.BANK, SHEET.CASH];

  let totalRemoved = 0;
  const report = [];

  targets.forEach(sheetName => {
    const ws = ss.getSheetByName(sheetName);
    if (!ws || ws.getLastRow() <= 1) return;

    const data = ws.getRange(2, 1, ws.getLastRow() - 1, ws.getLastColumn()).getValues();
    const seen = new Set();
    const toDelete = [];

    data.forEach((row, i) => {
      const key = row.map(c => String(c).trim()).join('|');
      if (seen.has(key)) { toDelete.push(i + 2); } else { seen.add(key); }
    });

    toDelete.reverse().forEach(rowNum => ws.deleteRow(rowNum));
    totalRemoved += toDelete.length;
    report.push({ sheet: sheetName, removed: toDelete.length });
  });

  return { ok: true, totalRemoved, report };
}

function deduplicateAll() {
  const result = deduplicateSheet({});
  SpreadsheetApp.getUi().alert(
    `✅ 重複削除完了\n合計 ${result.totalRemoved} 件削除\n\n` +
    result.report.map(r => `${r.sheet}: ${r.removed}件`).join('\n')
  );
}

// ================================================================
// 取込取り消し
// ================================================================
function cancelImport(params) {
  const { cardType, yearMonth, filename } = params;

  // 各シートの 取込ファイル列・明細月列
  const FILE_COL = { rakuten: 6, smbc: 6, paypay: 5, bank: 6 };
  const YM_COL   = { rakuten: 7, smbc: 7, paypay: 6, bank: 7 };
  const sheetMap = { rakuten: SHEET.RAKUTEN, smbc: SHEET.SMBC,
                     paypay: SHEET.PAYPAY,   bank: SHEET.BANK };

  const sheetName = sheetMap[cardType];
  if (!sheetName) return { ok: false, error: '不明なカード種別: ' + cardType };

  const ss    = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() < 2) return { ok: true, deleted: 0 };

  const fileCol = FILE_COL[cardType];
  const ymCol   = YM_COL[cardType];
  const data    = sheet.getRange(2, 1, sheet.getLastRow() - 1, Math.max(fileCol, ymCol)).getValues();

  const toDelete = [];
  data.forEach((row, i) => {
    const fileMatch = !filename || String(row[fileCol - 1]) === filename;
    const ymMatch   = String(row[ymCol - 1]) === yearMonth;
    if (fileMatch && ymMatch) toDelete.push(i + 2);
  });
  toDelete.reverse().forEach(r => sheet.deleteRow(r));

  // 取込履歴シートからも削除
  // 列: 取込日時(1) カード種別(2) ファイル名(3) 件数(4) 合計金額(5) 明細月(6)
  const impSheet = ss.getSheetByName(SHEET.IMPORTS);
  if (impSheet && impSheet.getLastRow() > 1) {
    const impData = impSheet.getRange(2, 1, impSheet.getLastRow() - 1, 6).getValues();
    const impDel  = [];
    impData.forEach((row, i) => {
      const fileMatch = !filename || String(row[2]) === filename;
      if (fileMatch && String(row[5]) === yearMonth && String(row[1]) === cardType) {
        impDel.push(i + 2);
      }
    });
    impDel.reverse().forEach(r => impSheet.deleteRow(r));
  }

  return { ok: true, deleted: toDelete.length };
}