    SpreadsheetApp.getActiveSpreadsheet()
      .getSheetByName(SHEET.CASH)
      .appendRow([today, note, adj, 'その他']);
  }
  return { ok: true };
}

// ================================================================
// 起動時一括取得
// ================================================================
function getInitialData(params) {
  const { year, month, yearMonth } = params;
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const assetWs      = ss.getSheetByName(SHEET.ASSET);
  const categoriesWs = ss.getSheetByName(SHEET.CATEGORIES);
  const rakutenWs    = ss.getSheetByName(SHEET.RAKUTEN);
  const smbcWs       = ss.getSheetByName(SHEET.SMBC);
  const paypayWs     = ss.getSheetByName(SHEET.PAYPAY);
  const cashWs       = ss.getSheetByName(SHEET.CASH);
  const bankWs       = ss.getSheetByName(SHEET.BANK);

  const C = ASSET_COLS;
  const assetAllData = (assetWs && assetWs.getLastRow() > 1)
    ? assetWs.getRange(2, 1, assetWs.getLastRow() - 1, C.PREV_DIFF).getValues()
    : [];

  function normalizeYM(val) {
    if (val instanceof Date) return val.getFullYear() + '/' + String(val.getMonth() + 1).padStart(2, '0');
    return String(val).substring(0, 7);
  }

  const catLast = categoriesWs ? categoriesWs.getLastRow() : 0;
  const cats = catLast > 1
    ? categoriesWs.getRange(2, 1, catLast - 1, 1).getValues().flat().filter(c => c !== '')
    : [];
  const categories = { ok: true, categories: cats };

  const prevMonth = month === 1 ? 12 : month - 1;
  const prevYear  = month === 1 ? year - 1 : year;
  const prevYM    = `${prevYear}/${String(prevMonth).padStart(2, '0')}`;

  const targetRows = assetAllData.filter(r => normalizeYM(r[0]) === yearMonth);
  const targetRow  = targetRows.length > 0
    ? targetRows.reduce((b, r) => (Number(r[C.TOTAL-1])||0) > (Number(b[C.TOTAL-1])||0) ? r : b, targetRows[0])
    : null;
  const prevAssetRows = assetAllData.filter(r => normalizeYM(r[0]) === prevYM);
  const prevAssetRow  = prevAssetRows.length > 0
    ? prevAssetRows.reduce((b, r) => (Number(r[C.TOTAL-1])||0) > (Number(b[C.TOTAL-1])||0) ? r : b, prevAssetRows[0])
    : null;

  const latestAsset = {
    ok: true, yearMonth,
    total:        targetRow ? (Number(targetRow[C.TOTAL-1])      || 0) : 0,
    prevTotal:    prevAssetRow ? (Number(prevAssetRow[C.TOTAL-1])|| 0) : null,
    prevDiff:     targetRow ? (Number(targetRow[C.PREV_DIFF-1])  || 0) : 0,
    cash:         targetRow ? (Number(targetRow[C.CASH-1])       || 0) : 0,
    yucho:        targetRow ? (Number(targetRow[C.YUCHO-1])      || 0) : 0,
    rakuten:      targetRow ? (Number(targetRow[C.RAKUTEN-1])    || 0) : 0,
    paypay:       targetRow ? (Number(targetRow[C.PAYPAY-1])     || 0) : 0,
    pnl:          targetRow ? (Number(targetRow[C.PNL-1])        || 0) : 0,
    monthlyInvest:targetRow ? (Number(targetRow[C.MONTHLY_INV-1])|| 0) : 0,
    cumInvest:    targetRow ? (Number(targetRow[C.CUM_INV-1])    || 0) : 0,
    safeTotal:    targetRow ? (Number(targetRow[C.SAFE_TOTAL-1]) || 0) : 0,
    riskTotal:    targetRow ? (Number(targetRow[C.RISK_TOTAL-1]) || 0) : 0,
  };

  const trendByMonth = {}, prevTrendByMonth = {};
  const prevTrendYear = year - 1;
  assetAllData.forEach(r => {
    const ym = normalizeYM(r[0]);
    const isCurrentYear = ym.startsWith(String(year));
    const isPrevYear    = ym.startsWith(String(prevTrendYear));
    if (!isCurrentYear && !isPrevYear) return;
    const total = Number(r[C.TOTAL-1]) || 0;
    const target = isCurrentYear ? trendByMonth : prevTrendByMonth;
    if (!target[ym] || total > target[ym].total) {
      const bank = (Number(r[C.YUCHO-1])||0) + (Number(r[C.RAKUTEN-1])||0) + (Number(r[C.PAYPAY-1])||0);
      const sec  = Number(r[C.RISK_TOTAL-1]) || 0;
      const cash = Number(r[C.CASH-1]) || 0;
      const safe = Number(r[C.SAFE_TOTAL-1]) || (bank + cash);
      target[ym] = { yearMonth: ym, bank, sec, cash, safe, total };
    }
  });
  const trend     = { ok: true, data: Object.values(trendByMonth).sort((a,b) => a.yearMonth.localeCompare(b.yearMonth)) };
  const prevTrend = { ok: true, year: prevTrendYear, data: Object.values(prevTrendByMonth).sort((a,b) => a.yearMonth.localeCompare(b.yearMonth)) };

  const secByMonth = {};
  assetAllData.forEach(r => {
    const ym = normalizeYM(r[0]);
    if (!ym.startsWith(String(year))) return;
    const total = Number(r[C.TOTAL-1]) || 0;
    if (!secByMonth[ym] || total > (secByMonth[ym]._total || 0)) {
      const cumDeposit = Number(r[C.CUM_INV-1])   || 0;
      const cumPnl     = Number(r[C.PNL-1])        || 0;
      const riskTotal  = Number(r[C.RISK_TOTAL-1]) || 0;
      const rate = cumDeposit > 0 ? Math.round(cumPnl / cumDeposit * 10000) / 100 : 0;
      secByMonth[ym] = { yearMonth: ym, monthDeposit: Number(r[C.MONTHLY_INV-1])||0,
                         cumDeposit, secValue: Number(r[C.SEC_VALUE-1])||0, cumPnl, rate, riskTotal, _total: total };
    }
  });
  const secRate = { ok: true, data: Object.values(secByMonth).map(({_total,...rest})=>rest).sort((a,b)=>a.yearMonth.localeCompare(b.yearMonth)) };

  function summarizeSheet(ws, dateCol, amountCol, catCol, targetYM) {
    if (!ws || ws.getLastRow() <= 1) return { total: 0, cats: {}, income: 0 };
    const maxCol = Math.max(dateCol, amountCol, catCol);
    const rows = ws.getRange(2, 1, ws.getLastRow() - 1, maxCol).getValues();
    let total = 0, income = 0;
    const cats = {};
    rows.forEach(row => {
      if (normalizeYM(row[dateCol-1]) !== targetYM) return;
      const amt = Number(row[amountCol-1]) || 0;
      if (!amt) return;
      if (amt < 0) { income += Math.abs(amt); return; }
      total += amt;
      const cat = String(row[catCol-1] || 'その他').trim() || 'その他';
      cats[cat] = (cats[cat] || 0) + amt;
    });
    return { total, cats, income };
  }

  function buildSummary(targetYM) {
    const sources = [
      { key: 'rakuten', ws: rakutenWs, dateCol:1, amountCol:4, catCol:5, label:'楽天カード' },
      { key: 'smbc',    ws: smbcWs,   dateCol:1, amountCol:4, catCol:5, label:'三井住友カード' },
      { key: 'paypay',  ws: paypayWs, dateCol:1, amountCol:3, catCol:4, label:'PayPay' },
      { key: 'cash',    ws: cashWs,   dateCol:1, amountCol:3, catCol:4, label:'現金' },
    ];
    let grandTotal = 0, totalIncome = 0;
    const breakdown = {}, categoryTotals = {};
    sources.forEach(src => {
      const r = summarizeSheet(src.ws, src.dateCol, src.amountCol, src.catCol, targetYM);
      breakdown[src.key] = { label: src.label, total: r.total };
      grandTotal += r.total;
      totalIncome += r.income;
      Object.entries(r.cats).forEach(([k, v]) => { categoryTotals[k] = (categoryTotals[k]||0) + v; });
    });
    return { ok: true, yearMonth: targetYM, grandTotal, totalIncome, balance: totalIncome - grandTotal, breakdown, categoryTotals };
  }

  const ym      = `${year}/${String(month).padStart(2,'0')}`;
  const prevYM2 = `${prevYear}/${String(prevMonth).padStart(2,'0')}`;
  const summary     = buildSummary(ym);
  const prevSummary = buildSummary(prevYM2);

  const kwWs = ss.getSheetByName(SHEET.KEYWORDS);
  let kwRules = [];
  if (kwWs && kwWs.getLastRow() > 1) {
    kwRules = kwWs.getRange(2, 1, kwWs.getLastRow() - 1, 2).getValues()
      .filter(r => r[0]).map(r => ({ keyword: String(r[0]), category: String(r[1]) }));
  }
  const keywordRules = { ok: true, rules: kwRules };

  const detailSources = [
    { key: 'rakuten', ws: rakutenWs, dateCol:1, shopCol:3, amountCol:4, catCol:5 },
    { key: 'smbc',    ws: smbcWs,   dateCol:1, shopCol:3, amountCol:4, catCol:5 },
    { key: 'paypay',  ws: paypayWs, dateCol:1, shopCol:2, amountCol:3, catCol:4 },
    { key: 'bank',    ws: bankWs,   dateCol:1, shopCol:2, amountCol:3, catCol:5 },
    { key: 'cash',    ws: cashWs,   dateCol:1, shopCol:2, amountCol:3, catCol:4 },
  ];
  const detailRows = [];
  detailSources.forEach(src => {
    if (!src.ws || src.ws.getLastRow() <= 1) return;
    const maxCol = Math.max(src.dateCol, src.shopCol, src.amountCol, src.catCol);
    const rows = src.ws.getRange(2, 1, src.ws.getLastRow() - 1, maxCol).getValues();
    rows.forEach((row, i) => {
      if (toYM(row[src.dateCol - 1]) !== ym) return;
      const amt = Number(row[src.amountCol - 1]) || 0;
      if (!amt) return;
      const dateVal = row[src.dateCol - 1];
      detailRows.push({
        src: src.key, rowNum: i + 2,
        date: Utilities.formatDate(dateVal instanceof Date ? dateVal : new Date(dateVal), 'Asia/Tokyo', 'yyyy/MM/dd'),
        shop: String(row[src.shopCol - 1] || ''),
        amount: amt, type: amt < 0 ? 'income' : 'expense',
        category: String(row[src.catCol - 1] || ''),
      });
    });
  });
  detailRows.sort((a, b) => b.date.localeCompare(a.date));
  const details = { ok: true, rows: detailRows };

  return { ok: true, categories, keywordRules, summary, prevSummary, trend, prevTrend, secRate, latestAsset, details };
}

